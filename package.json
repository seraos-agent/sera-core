{
  "name": "sera-core",
  "version": "1.0.0",
  "description": "Sera Core - Phase 1 Foundation",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "ts-node --transpile-only src/server/index.ts",
    "start:server": "ts-node --transpile-only src/server/index.ts",
    "start:reception": "npm --prefix sera-reception run start",
    "dev:docs": "npm --prefix sera-docs run start -- --port 3003",
    "build": "tsc",
    "deploy:core": "gcloud builds submit --config cloudbuild.core.yaml . && gcloud run deploy sera-core --image asia-southeast1-docker.pkg.dev/sera-core/sera-core-images/sera-core-api:latest --region asia-southeast1 --quiet",
    "deploy:frontend": "npm --prefix sera-frontend run build && vercel --prod --cwd sera-frontend"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.51.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-brave-search": "^0.6.2",
    "@modelcontextprotocol/server-memory": "^0.6.2",
    "@nktkas/hyperliquid": "^0.33.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "cron-parser": "^5.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ox": "^1.6.2",
    "socket.io": "^4.8.3",
    "solc": "^0.8.24",
    "telegraf": "^4.16.3",
    "viem": "^2.54.1"
  }
}
